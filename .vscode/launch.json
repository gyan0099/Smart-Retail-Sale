{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Streamlit (Smart Retail Sales)",
            "type": "debugpy",
            "request": "launch",
            "module": "streamlit",
            "args": [
                "run",
                "${workspaceFolder}/app.py",
                "--server.address=127.0.0.1",
                "--server.port=8501",
                "--server.enableCORS=false",
                "--server.enableXsrfProtection=false"
            ],
            "jinja": true,
            "justMyCode": true,
            "console": "integratedTerminal"
        }
    ]
}
